<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Version>0.2.0.0</Version>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <GenerateAssemblyInformationalVersionAttribute>false</GenerateAssemblyInformationalVersionAttribute>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <Platforms>x64</Platforms>
    <Name>Sapphire Avenue Discord Bridge</Name>
    <AssemblyName>SapphireAvenueRelay</AssemblyName>
    <Author>FranFkntastic</Author>
    <Description>Connect one FFXIV cross-world linkshell to a community-owned Discord bot.</Description>
    <Punchline>Bridge one CWLS with your community Discord.</Punchline>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ECommons" Version="3.2.1.15" />
    <Content Include="SapphireAvenueRelay.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <ProjectReference Include="$(FranthropyDalamudProject)" />
    <InternalsVisibleTo Include="SapphireAvenueRelay.Tests" />
  </ItemGroup>

  <Target Name="GenerateBuildIdentity" BeforeTargets="CoreCompile">
    <Exec Command="git rev-parse --short HEAD" ConsoleToMsBuild="true" StandardOutputImportance="Low">
      <Output TaskParameter="ConsoleOutput" ItemName="_GitCommitOutput" />
    </Exec>
    <Exec Command="git status --porcelain" ConsoleToMsBuild="true" StandardOutputImportance="Low">
      <Output TaskParameter="ConsoleOutput" ItemName="_GitStatusOutput" />
    </Exec>
    <PropertyGroup>
      <GitCommit>@(_GitCommitOutput)</GitCommit>
      <GitCommit Condition="'$(GitCommit)' == ''">unknown</GitCommit>
      <GitDirtySuffix Condition="'@(_GitStatusOutput)' != ''">.dirty</GitDirtySuffix>
      <GeneratedBuildInfoPath>$(IntermediateOutputPath)SapphireAvenueRelay.BuildInfo.g.cs</GeneratedBuildInfoPath>
    </PropertyGroup>
    <ItemGroup>
      <_GeneratedBuildInfoLine Include="using System.Reflection%3B" />
      <_GeneratedBuildInfoLine Include="[assembly: AssemblyInformationalVersion(&quot;$(Version)+$(GitCommit)$(GitDirtySuffix)&quot;)]" />
    </ItemGroup>
    <WriteLinesToFile File="$(GeneratedBuildInfoPath)" Lines="@(_GeneratedBuildInfoLine)" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup><Compile Include="$(GeneratedBuildInfoPath)" /></ItemGroup>
  </Target>
</Project>
